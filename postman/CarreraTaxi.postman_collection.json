    {
      "name": "Carreras de taxi",
      "item": [
        {
          "name": "C - Registrar carrera (MEMBER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/carreras-taxi",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "carreras-taxi"
              ]
            },
            "description": "Registra una carrera. El id lo genera el servidor y se guarda en carrera_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"María Fernanda Pájaro\",\n  \"taxi\": \"UAK512\",\n  \"kilometros\": 6.4,\n  \"barrioInicio\": \"El Recreo\",\n  \"barrioLlegada\": \"Centro Histórico\",\n  \"cantidadPasajeros\": 2,\n  \"taxista\": \"Jorge Luis Marrugo\",\n  \"precio\": 14000,\n  \"duracionMinutos\": 25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{member_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', function () { pm.response.to.have.status(201); });",
                  "const carrera = pm.response.json();",
                  "pm.collectionVariables.set('carrera_id', carrera.id);",
                  "pm.test('Normaliza la placa', function () { pm.expect(carrera.taxi).to.eql('UAK512'); });",
                  "pm.test('Calcula el precio por kilómetro', function () { pm.expect(Number(carrera.precioPorKilometro)).to.eql(2187.5); });"
                ]
              }
            }
          ]
        },
        {
          "name": "L - Listar carreras",
          "request": {
            "method": "GET",
            "header": [
              {
