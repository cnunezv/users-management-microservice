{
  "info": {
    "name": "CarreraTaxi - Spring Boot Hexagonal (Ejercicio 19)",
    "description": "Pruebas de la API REST del CRUDL de carreras de taxi.\n\n1. Ajusta `base_url` (local: http://localhost:8080).\n2. Ejecuta la carpeta **Auth** para obtener los tokens.\n3. Ejecuta **Carreras de taxi** en orden: el registro guarda `carrera_id` para las demás peticiones.\n\nPermisos: consultar con cualquier rol; registrar y actualizar con ADMIN o MEMBER; eliminar solo ADMIN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{admin_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "member_token",
      "value": ""
    },
    {
      "key": "reviewer_token",
      "value": ""
    },
    {
      "key": "carrera_id",
      "value": ""
    }
  ],
