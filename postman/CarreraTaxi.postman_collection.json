          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Es la carrera registrada', function () { pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('carrera_id')); });"
                ]
              }
            }
          ]
        },
